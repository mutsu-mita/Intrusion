<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>通信システム</title>
  <style>
    body {
      font-family: sans-serif;
      max-width: 500px;
      margin: 50px auto;
      padding: 20px;
      background-color: #f9f9f9;
    }
    .container {
      background: #ffffff;
      padding: 24px;
      border-radius: 8px;
      box-shadow: 0 2px 8px rgba(0,0,0,0.1);
    }
    h2 {
      margin-top: 0;
      font-size: 1.2rem;
      color: #333;
    }
    .form-group {
      margin-bottom: 16px;
    }
    label {
      display: block;
      margin-bottom: 8px;
      font-weight: bold;
      color: #555;
    }
    input[type="text"] {
      width: 100%;
      padding: 10px;
      box-sizing: border-box;
      border: 1px solid #ccc;
      border-radius: 4px;
      font-size: 1rem;
    }
    button {
      width: 100%;
      padding: 10px;
      background-color: #007bff;
      color: white;
      border: none;
      border-radius: 4px;
      font-size: 1rem;
      cursor: pointer;
    }
    button:hover {
      background-color: #0056b3;
    }
    .result-box {
      margin-top: 20px;
      padding: 12px;
      border-radius: 4px;
      background-color: #eef2f5;
      font-size: 1.1rem;
      font-weight: bold;
      text-align: center;
      min-height: 24px;
    }
  </style>
</head>
<body>

<div class="container">
  <h2>テキスト照会</h2>
  
  <div class="form-group">
    <label for="inputText">入力テキスト：</label>
    <input type="text" id="inputText" placeholder="テキストを入力してください">
  </div>
  
  <button onclick="checkText()">送信</button>

  <div class="result-box" id="resultOutput"></div>
</div>

<script>
  // 1対1対応のリスト（連想配列/オブジェクト）
  // ここに「入力テキスト」と「返したい単語」のペアを追加・変更してください
  const wordDictionary = {
    "りんご": "Apple",
    "みかん": "Orange",
    "ぶどう": "Grape",
    "1234": "認証完了",
    "テスト": "SUCCESS"
  };

  function checkText() {
    const inputVal = document.getElementById("inputText").value.trim();
    const resultDiv = document.getElementById("resultOutput");

    if (inputVal === "") {
      resultDiv.innerText = "テキストを入力してください";
      resultDiv.style.color = "#666";
      return;
    }

    // 入力値がリスト内に存在するか判定
    if (inputVal in wordDictionary) {
      resultDiv.innerText = wordDictionary[inputVal];
      resultDiv.style.color = "#28a745"; // 緑色で表示
    } else {
      resultDiv.innerText = "誤っています";
      resultDiv.style.color = "#dc3545"; // 赤色で表示
    }
  }

  // Enterキーを押したときにも送信される処理
  document.getElementById("inputText").addEventListener("keypress", function(event) {
    if (event.key === "Enter") {
      checkText();
    }
  });
</script>

</body>
</html>
